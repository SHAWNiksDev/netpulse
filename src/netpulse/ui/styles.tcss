Screen {
    background: $boost;
}

#summary {
    dock: top;
    height: 1;
    background: $surface;
    color: $text;
    padding: 0 1;
}

#main {
    height: 1fr;
}

#hosts {
    height: 100%;
    background: $surface;
}

#hosts > .datatable--header {
    text-style: bold;
    color: $text;
    background: $surface-lighten-1;
}

#side {
    width: 46;
    border-left: round $surface-lighten-1;
    padding: 0 2;
}

.chart-title {
    color: $text-muted;
    text-style: italic;
    margin-top: 1;
}

#chart {
    height: 7;
}

#detail {
    margin-top: 1;
}
